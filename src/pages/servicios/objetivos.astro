---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';

const images = [
  {
    url: 'https://images.pexels.com/photos/4498151/pexels-photo-4498151.jpeg',
    title: 'Preparación Física',
    description: 'Optimización del rendimiento para pruebas específicas',
  },
  {
    url: 'https://images.pexels.com/photos/3822719/pexels-photo-3822719.jpeg',
    title: 'Competiciones',
    description: 'Preparación nutricional para eventos deportivos',
  },
  {
    url: 'https://images.pexels.com/photos/3912944/pexels-photo-3912944.jpeg',
    title: 'Oposiciones',
    description: 'Nutrición para máximo rendimiento mental y físico',
  },
];
---

<Layout
  title="Consigue tus Objetivos | Nutricional Coach"
  description="Programa especializado de nutrición para oposiciones, competiciones deportivas y objetivos de alto rendimiento."
>
  <div class="bg-accent min-h-screen py-16">
    <div class="container mx-auto px-4">
      <a href="/" class="text-primary hover:text-opacity-80 mb-8 inline-block">
        ← Volver a Servicios
      </a>

      <h1 class="font-display text-5xl text-secondary mb-8">CONSIGUE TUS OBJETIVOS</h1>

      <div class="prose max-w-none mb-12">
        <p class="text-xl text-gray-600">
          Programa especializado para alcanzar tus metas específicas, ya sea una oposición,
          una competición deportiva o cualquier otro desafío que requiera un rendimiento óptimo.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
        {images.map((image) => (
          <div class="rounded-xl overflow-hidden shadow-lg">
            <Image
              src={image.url}
              alt={image.title}
              width={400}
              height={300}
              format="webp"
              quality={80}
              loading="lazy"
              decoding="async"
              class="w-full h-64 object-cover"
            />
            <div class="p-6 bg-secondary">
              <h3 class="font-display text-xl text-silver mb-2">{image.title}</h3>
              <p class="text-accent">{image.description}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-secondary text-accent p-8 rounded-xl">
          <h2 class="font-display text-3xl mb-6 text-silver">Preparación para Oposiciones</h2>
          <ul class="space-y-3">
            <li class="flex items-center">
              <span class="text-primary mr-2">•</span>
              Nutrición para optimizar el rendimiento cognitivo
            </li>
            <li class="flex items-center">
              <span class="text-primary mr-2">•</span>
              Gestión del estrés a través de la alimentación
            </li>
            <li class="flex items-center">
              <span class="text-primary mr-2">•</span>
              Mejora de la concentración y memoria
            </li>
            <li class="flex items-center">
              <span class="text-primary mr-2">•</span>
              Preparación para pruebas físicas
            </li>
          </ul>
        </div>

        <div class="bg-primary text-accent p-8 rounded-xl">
          <h2 class="font-display text-3xl mb-6">Competiciones Deportivas</h2>
          <ul class="space-y-3">
            <li class="flex items-center">
              <span class="text-silver mr-2">•</span>
              Periodización nutricional
            </li>
            <li class="flex items-center">
              <span class="text-silver mr-2">•</span>
              Nutrición pre y post competición
            </li>
            <li class="flex items-center">
              <span class="text-silver mr-2">•</span>
              Hidratación y suplementación específica
            </li>
            <li class="flex items-center">
              <span class="text-silver mr-2">•</span>
              Optimización del peso para la categoría
            </li>
          </ul>
        </div>
      </div>

      <div class="mt-12 text-center">
        <a
          href="https://docs.google.com/forms/d/e/1FAIpQLSdOwSxNXy-eett_h9o1fvvi47I_feumHtY-j6tQHu9h6ygXvw/viewform?pli=1"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block bg-primary text-accent px-8 py-3 rounded-lg font-display hover:bg-opacity-90 transition-colors"
        >
          EMPIEZA TU PREPARACIÓN
        </a>
      </div>
    </div>
  </div>
</Layout>
