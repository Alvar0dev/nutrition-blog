---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';

const posts = [
  {
    title: 'La Importancia del Desayuno',
    description: 'Descubre por qué el desayuno es considerado la comida más importante del día y cómo optimizarlo.',
    link: 'https://www.fitnessrevolucionario.com/2015/11/28/por-que-el-desayuno-no-es-la-comida-mas-importante-del-dia/',
    image: 'https://images.pexels.com/photos/376464/pexels-photo-376464.jpeg',
    category: 'Nutrición Básica',
  },
  {
    title: 'Proteínas Vegetales',
    description: 'Guía completa sobre las mejores fuentes de proteína vegetal y cómo incorporarlas a tu dieta.',
    link: 'https://www.fitnessrevolucionario.com/2019/07/06/proteina-vegetal/',
    image: 'https://images.pexels.com/photos/1640777/pexels-photo-1640777.jpeg',
    category: 'Nutrición Vegana',
  },
  {
    title: 'Mitos de las Dietas',
    description: 'Desmontando los mitos más comunes sobre las dietas y la pérdida de peso.',
    link: 'https://www.fitnessrevolucionario.com/2020/01/11/mitos-dietas/',
    image: 'https://images.pexels.com/photos/4397833/pexels-photo-4397833.jpeg',
    category: 'Educación Nutricional',
  },
  {
    title: 'Nutrición para Deportistas',
    description: 'Optimiza tu rendimiento deportivo con una nutrición adecuada.',
    link: 'https://www.fitnessrevolucionario.com/2019/11/16/nutricion-deportiva/',
    image: 'https://images.pexels.com/photos/4498151/pexels-photo-4498151.jpeg',
    category: 'Nutrición Deportiva',
  },
  {
    title: 'Alimentación Antiinflamatoria',
    description: 'Aprende sobre los alimentos que ayudan a reducir la inflamación en tu cuerpo.',
    link: 'https://www.fitnessrevolucionario.com/2018/09/22/dieta-antiinflamatoria/',
    image: 'https://images.pexels.com/photos/1435904/pexels-photo-1435904.jpeg',
    category: 'Salud y Bienestar',
  },
  {
    title: 'Gestión del Estrés y Nutrición',
    description: 'Cómo la alimentación puede ayudarte a manejar mejor el estrés.',
    link: 'https://www.fitnessrevolucionario.com/2019/03/30/estres-cortisol/',
    image: 'https://images.pexels.com/photos/3759658/pexels-photo-3759658.jpeg',
    category: 'Salud Mental',
  },
  {
    title: 'Suplementación Inteligente',
    description: 'Guía sobre suplementos nutricionales: cuáles tomar y cuáles evitar.',
    link: 'https://www.fitnessrevolucionario.com/2019/05/25/suplementos/',
    image: 'https://images.pexels.com/photos/4397840/pexels-photo-4397840.jpeg',
    category: 'Suplementación',
  },
  {
    title: 'Nutrición para Estudiantes',
    description: 'Mejora tu concentración y rendimiento académico con la alimentación correcta.',
    link: 'https://www.fitnessrevolucionario.com/2018/11/24/cerebro-alimentacion/',
    image: 'https://images.pexels.com/photos/3755755/pexels-photo-3755755.jpeg',
    category: 'Nutrición Específica',
  },
  {
    title: 'Hidratación y Salud',
    description: 'La importancia del agua y cómo mantenerte correctamente hidratado.',
    link: 'https://www.fitnessrevolucionario.com/2019/08/17/agua-hidratacion/',
    image: 'https://images.pexels.com/photos/327090/pexels-photo-327090.jpeg',
    category: 'Hidratación',
  },
];
---

<Layout
  title="Blog de Nutrición | Nutricional Coach"
  description="Artículos sobre nutrición básica, deportiva, suplementación, hidratación y salud para mejorar tu alimentación día a día."
>
  <div class="bg-accent py-12">
    <div class="container mx-auto px-4">
      <h1 class="font-display text-5xl text-secondary mb-12 text-center">BLOG DE NUTRICIÓN</h1>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post, index) => (
          <a href={post.link} target="_blank" rel="noopener noreferrer" class="group">
            <article class="bg-secondary rounded-xl overflow-hidden shadow-lg transform hover:-translate-y-2 transition-transform duration-300">
              <div class="relative h-48 overflow-hidden">
                <Image
                  src={post.image}
                  alt={post.title}
                  width={400}
                  height={300}
                  format="webp"
                  quality={80}
                  loading={index < 3 ? 'eager' : 'lazy'}
                  decoding="async"
                  class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-300"
                />
                <div class="absolute top-0 right-0 bg-primary text-accent px-3 py-1 m-2 rounded-lg">
                  {post.category}
                </div>
              </div>
              <div class="p-6">
                <h2 class="font-display text-xl text-accent mb-3">{post.title}</h2>
                <p class="text-gray-400 font-body">{post.description}</p>
                <div class="flex justify-between items-center">
                  <span class="text-sm text-gray-500">{post.link}</span>
                  <span class="text-primary hover:text-opacity-80 font-display">LEER MÁS →</span>
                </div>
              </div>
            </article>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>
