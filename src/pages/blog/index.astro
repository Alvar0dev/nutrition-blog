---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { getPublishedPosts, formatDate, getReadingTime } from '../../lib/posts.js';

const posts = await getPublishedPosts();
---

<Layout
  title="Blog de Nutrición | Nutricional Coach"
  description="Artículos sobre nutrición básica, deportiva, suplementación, hidratación y salud para mejorar tu alimentación día a día."
>
  <div class="bg-accent py-12">
    <div class="container mx-auto px-4">
      <h1 class="font-display text-5xl text-secondary mb-12 text-center">BLOG DE NUTRICIÓN</h1>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post, index) => (
          <a href={`/blog/${post.id}`} class="group">
            <article class="h-full flex flex-col bg-secondary rounded-xl overflow-hidden shadow-lg transform hover:-translate-y-2 transition-transform duration-300">
              <div class="relative h-48 overflow-hidden">
                <Image
                  src={post.data.image}
                  alt={post.data.imageAlt}
                  width={400}
                  height={300}
                  format="webp"
                  quality={80}
                  loading={index < 3 ? 'eager' : 'lazy'}
                  fetchpriority={index === 0 ? 'high' : undefined}
                  decoding="async"
                  class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-300"
                />
                <div class="absolute top-0 right-0 bg-primary text-accent px-3 py-1 m-2 rounded-lg">
                  {post.data.category}
                </div>
              </div>
              <div class="p-6 flex flex-col flex-grow">
                <h2 class="font-display text-xl text-accent mb-3">{post.data.title}</h2>
                <p class="text-gray-400 font-body flex-grow">{post.data.description}</p>
                <div class="flex justify-between items-center mt-4">
                  <span class="text-sm text-gray-400 font-body">
                    <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                    <span aria-hidden="true"> · </span>
                    {getReadingTime(post.body)} min
                  </span>
                  <span class="text-primary group-hover:text-opacity-80 font-display">LEER MÁS →</span>
                </div>
              </div>
            </article>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>
