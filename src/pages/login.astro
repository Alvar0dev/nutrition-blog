---
import Layout from '../layouts/Layout.astro';
import AuthPlaceholder from '../components/AuthPlaceholder.jsx';
---

<Layout
  title="Acceso Clientes | Nutricional Coach"
  description="Área de acceso privado para clientes de Nutricional Coach."
  noindex={true}
>
  <section class="bg-accent py-20">
    <div class="container mx-auto px-4 max-w-md">
      <div class="bg-secondary text-accent p-8 rounded-xl shadow-lg text-center space-y-4">
        <h1 class="font-display text-3xl text-silver">ACCESO CLIENTES</h1>
        <p class="font-body text-sm text-gray-300">
          El portal privado de seguimiento para clientes estará disponible próximamente.
        </p>
        <AuthPlaceholder />
        <div class="pt-4">
          <a
            href="/contacto"
            class="inline-block bg-primary text-accent px-6 py-2.5 rounded-lg font-display hover:bg-opacity-90 transition-colors"
          >
            CONTACTAR CON ÁLVARO
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
