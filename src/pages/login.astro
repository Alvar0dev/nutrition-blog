---
import Layout from '../layouts/Layout.astro';
import AuthPlaceholder from '../components/AuthPlaceholder.jsx';
---

<Layout
  title="Acceso Clientes | Nutricional Coach"
  description="Área de acceso para clientes de Nutricional Coach."
>
  <section class="bg-accent py-20">
    <div class="container mx-auto px-4 max-w-md">
      <div class="bg-secondary text-accent p-8 rounded-xl shadow-lg">
        <h1 class="font-display text-3xl text-silver mb-6 text-center">ACCESO CLIENTES</h1>
        <AuthPlaceholder client:load />
      </div>
    </div>
  </section>
</Layout>
