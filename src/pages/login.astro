---
import Layout from '../layouts/Layout.astro';
import AuthIsland from '../components/AuthIsland.jsx';
---

<Layout
  title="Acceso Clientes | Nutricional Coach"
  description="Área de acceso privado para clientes de Nutricional Coach."
  noindex={true}
>
  <section class="bg-accent py-16 md:py-20">
    <div class="container mx-auto px-4 max-w-md">
      <div class="bg-secondary text-accent p-8 rounded-xl shadow-lg text-center space-y-6">
        <div class="space-y-2">
          <h1 class="font-display text-3xl text-silver">ACCESO CLIENTES</h1>
          <p class="font-body text-sm text-gray-300">
            Inicia sesión con tu cuenta de cliente para acceder a tu área privada de seguimiento
            nutricional.
          </p>
        </div>

        <AuthIsland client:load />

        <div class="pt-4 border-t border-accent/15 space-y-3">
          <p class="font-body text-xs text-gray-300">¿Aún no eres cliente o necesitas ayuda?</p>
          <a
            href="/contacto"
            class="inline-block bg-accent/10 text-silver hover:bg-primary hover:text-accent px-6 py-2.5 rounded-lg font-display text-sm transition-colors"
          >
            CONTACTAR CON ÁLVARO
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
