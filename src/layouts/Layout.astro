---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Navbar from '../components/Navbar.jsx';
import Footer from '../components/Footer.astro';
import defaultOgImage from '../assets/LOGO.png';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Local imported image or a path/URL string. Defaults to the site logo. */
  image?: ImageMetadata | string;
  pathname?: string;
  noindex?: boolean;
  /** Open Graph type: `website` for regular pages, `article` for blog posts. */
  ogType?: 'website' | 'article';
}

const {
  title = 'Nutricional Coach',
  description = 'Nutrición personalizada y consciente para alcanzar tus objetivos de salud y rendimiento.',
  image = defaultOgImage,
  pathname = Astro.url.pathname,
  noindex = false,
  ogType = 'website',
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://nutricionalcoach.com');
const imageSrc = typeof image === 'string' ? image : image.src;
const ogImage = new URL(imageSrc, siteUrl).href;
---

<html lang="es">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={ogImage}
      pathname={pathname}
      noindex={noindex}
      ogType={ogType}
    />
    <!-- Page-specific head content (e.g. per-article JSON-LD) -->
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-primary focus:text-accent focus:px-4 focus:py-2 focus:rounded-lg focus:font-display focus:shadow-lg"
    >
      Saltar al contenido principal
    </a>
    <Navbar client:visible pathname={pathname}>
      <Image
        src={defaultOgImage}
        alt="Nutricional Coach"
        width={192}
        height={192}
        format="webp"
        quality={85}
        loading="eager"
        decoding="async"
        class="w-full h-auto rounded-xl shadow-lg"
      />
    </Navbar>
    <main id="main-content" class="flex-grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>
