---
import { Image } from 'astro:assets';
import logo from '../assets/LOGO.png';
---

<footer class="bg-secondary text-accent">
  <div class="container mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      <div>
        <a href="/" class="inline-block w-48 mb-6" aria-label="Nutricional Coach - Ir al inicio">
          <Image
            src={logo}
            alt="Nutricional Coach"
            width={192}
            height={192}
            format="webp"
            quality={85}
            loading="lazy"
            decoding="async"
            class="w-full h-auto"
          />
        </a>
        <p class="font-body text-accent/90">
          Transformando vidas a través de la nutrición personalizada y consciente.
        </p>
      </div>
      <div>
        <h2 class="font-display text-xl mb-6 text-accent">ENLACES</h2>
        <ul class="space-y-4 font-body">
          <li>
            <a href="/" class="text-accent hover:text-primary transition-colors">
              INICIO
            </a>
          </li>
          <li>
            <a href="/blog" class="text-accent hover:text-primary transition-colors">
              BLOG
            </a>
          </li>
          <li>
            <a href="/servicios" class="text-accent hover:text-primary transition-colors">
              SERVICIOS
            </a>
          </li>
          <li>
            <a href="/contacto" class="text-accent hover:text-primary transition-colors">
              CONTACTO
            </a>
          </li>
        </ul>
      </div>
      <div>
        <h2 class="font-display text-xl mb-6 text-accent">CONTACTO</h2>
        <ul class="space-y-4 font-body text-accent">
          <li>
            <a href="mailto:alvaroaguilarcejas@hotmail.com" class="hover:text-primary transition-colors">
              alvaroaguilarcejas@hotmail.com
            </a>
          </li>
          <li>
            <a href="mailto:info@nutricionalcoach.com" class="hover:text-primary transition-colors">
              info@nutricionalcoach.com
            </a>
          </li>
          <li>
            <a href="tel:+34655397061" class="hover:text-primary transition-colors">
              655 397 061
            </a>
          </li>
          <li>
            <div class="flex flex-wrap gap-4 mt-4">
              <a
                href="https://wa.me/34655397061"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Contactar por WhatsApp"
                class="text-accent hover:text-primary transition-colors"
              >
                WhatsApp
              </a>
              <a
                href="https://www.instagram.com/"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Visitar perfil de Instagram"
                class="text-accent hover:text-primary transition-colors"
              >
                Instagram
              </a>
              <a
                href="https://www.linkedin.com/"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Visitar perfil de LinkedIn"
                class="text-accent hover:text-primary transition-colors"
              >
                LinkedIn
              </a>
            </div>
          </li>
        </ul>
      </div>
    </div>
    <div class="mt-12 pt-8 border-t border-accent/20 flex flex-col items-center">
      <p class="text-center text-accent/80 font-body text-sm">
        &copy; {new Date().getFullYear()} Nutricional Coach. Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>
